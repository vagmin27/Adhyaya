# Server Configuration
PORT=8000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/adhyaya

# CORS Configuration (comma-separated origins in production, e.g. https://example.com)
CORS_ORIGIN=*

# JWT Authentication Secrets & Expiry
ACCESS_TOKEN_SECRET=your_access_token_secret_min_32_characters_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_characters_here
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
